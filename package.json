{
  "name": "orbit",
  "version": "1.0.0",
  "private": true,
  "description": "Orbit — project management with kanban boards",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "^9.31.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11"
  },
  "lint-staged": {
    "client/**/*.{ts,tsx}": [
      "eslint --fix --config client/eslint.config.mjs",
      "prettier --write"
    ],
    "server/**/*.ts": [
      "eslint --fix --config server/eslint.config.mjs",
      "prettier --write"
    ],
    "**/*.{js,mjs,cjs,json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
